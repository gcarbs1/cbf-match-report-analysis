{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbf-sumulas-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cbf-sumulas-ai",
      "database_id": "ee512ef0-8ae9-4ad8-ae28-3528e1926422",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ALLOWED_ORIGINS": "https://gcarbs1.github.io,http://localhost:8000,http://127.0.0.1:8000,null"
  }
}
